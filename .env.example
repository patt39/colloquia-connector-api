NODE_ENV=dev
PORT=6000
API_VERSION=v1
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/colloquia_connector_api?schema=public
COOKIE_KEY=replace-with-a-long-random-secret
COOKIE_ACCESS_EXPIRE=86400000
PORTAL_PROVISIONING_KEY=replace-with-a-separate-long-random-secret
PORTAL_BASE_URL=http://localhost:3000
RESEND_SMTP_API_KEY=re_your_resend_api_key
RESEND_SMTP_EMAIL=services@your-verified-domain.com

VTIGER_BASE_URL=https://your-instance.vtiger.com
VTIGER_USERNAME=your-vtiger-user
VTIGER_ACCESS_KEY=your-vtiger-api-access-key
VTIGER_TIMEOUT_MS=15000